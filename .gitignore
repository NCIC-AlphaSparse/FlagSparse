build/
dist/
*.egg-info/
*.egg
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Test and benchmark output. The runner writes pytest_results_<timestamp>/ into
# the repo root by default (run_flagsparse_pytest.py, --results-dir overrides),
# and the C API tools default to capi_results/. These are results, not inputs:
# every one of them is regenerated by rerunning the command that made it.
pytest_results_*/
backend_test_results_*/
capi_results/
delivery_python_smoke/

# Per-operator benchmark CSVs, written into the working directory when the
# script is run without --csv/--csv-summary.
spmv_bsr_results.csv
spmv_csc_results.csv
test_spmv_bsr_scipy.csv

# SpGEMM's in-flight marker: it names the matrix being processed so that a
# rocSPARSE VMFault (SIGABRT, uncatchable) leaves behind which one triggered it.
# Deleted on a clean finish, so its presence means the last run died.
*.inflight.json

# Editor settings. `.vscode/settings.json` was committed by accident in the
# first commit and carried one developer's absolute path, which is useless to
# everyone else and churns on every machine.
.vscode/

# Backend delivery notes and staging copies; kept out of the repo by the maintainer.
/prompt.md
/modified/
